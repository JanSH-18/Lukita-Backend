# Neon: usa la URL con pooler para la app. NO pongas ?schema=lukita
# (el esquema ya esta declarado en prisma/schema.prisma).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

PORT=4000

# Usar un valor largo y aleatorio distinto en cada entorno.
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="7d"

# Lector de boletas "vision-aula"
VISION_AULA_URL="https://boletas-aula.analizodatos.com/v1/boleta"
VISION_AULA_TOKEN=""

# Groq (console.groq.com). Mientras no este configurado, /voz responde datos de prueba.
GROQ_API_KEY=""
# GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
# GROQ_LLM_MODEL="openai/gpt-oss-120b"

# Azure Speech (texto a voz). Sin configurar, /chat/hablar responde 503.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# AZURE_SPEECH_VOICE="es-PE-CamilaNeural"
